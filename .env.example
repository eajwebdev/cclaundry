APP_NAME="Cane & Cotton Laundry"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://caneandcotton.example.com
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@caneandcotton.example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
BILLING_CYCLE_MONTHS=1
BILLING_NOTIFY_DAYS=3
BILLING_LOCK_GRACE_DAYS=2
BILLING_MIN_AMOUNT=20

# ── Maps & rider tracking ────────────────────────────────────────────────────
# The map stack is keyless by design: MapLibre GL JS against OpenFreeMap vector
# tiles, with address search proxied to OpenStreetMap's Nominatim. Nothing here
# needs an API key or a billing account, so every value below is optional and
# the defaults in config/maps.php work as shipped.

# Nominatim's usage policy requires traffic to identify itself. Set this to
# something naming this deployment and a contact address, or lookups may be
# blocked. This is the one value you should actually set.
NOMINATIM_USER_AGENT="CaneAndCottonLaundry/1.0 (+https://ccl.eajwebdev.com)"

# Service area — defaults are Kabankalan City, Negros Occidental.
# MAP_CENTER_LAT=9.9886
# MAP_CENTER_LNG=122.8112
# MAP_SERVICE_RADIUS_KM=30

# Swap in a different tile provider without touching application code.
# MAP_STYLE_LIGHT=https://tiles.openfreemap.org/styles/positron
# MAP_STYLE_DARK=https://tiles.openfreemap.org/styles/dark

# Live tracking cadence, in seconds. Riders post on the first, watching maps
# poll on the second. Raising both lowers server load and phone battery use.
# TRACKING_PING_INTERVAL=10
# TRACKING_POLL_INTERVAL=10
# TRACKING_RETAIN_DAYS=30

# Rider routing (OSRM). Free and keyless — the default is the FOSSGIS instance
# that powers openstreetmap.org's own directions.
# OSRM_ENDPOINT=https://routing.openstreetmap.de/routed-car
# OSRM_USER_AGENT="CaneAndCottonLaundry/1.0 (+https://ccl.eajwebdev.com)"
# Metres a rider must stray from the drawn line before the route recalculates.
# ROUTE_REROUTE_METRES=60
